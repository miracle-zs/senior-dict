# Built application files
*.apk
*.aar
*.ap_
*.aab

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard / Dex
*.pro.tmp

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# macOS
.DS_Store

# NDK / CMake
.externalNativeBuild/
.cxx/

# Python cache
__pycache__/
*.pyc

# Raw downloaded datasets (can be fetched via scripts/01_fetch_raw_data.py)
data/raw/

# Large model files (>50MB) and prebuilt JNI binaries (run scripts/setup_models.py to restore)
app/src/main/assets/models/*.mnn
app/src/main/assets/models/*.onnx
app/src/main/jniLibs/
